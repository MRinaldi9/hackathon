# ============================================================
# Variabili d'ambiente — Hagenthon / Inclusione Finanziaria
#
# IMPORTANTE: copia questo file in .env e compila i valori.
# NON committare mai il file .env: contiene segreti reali.
# ============================================================

# Porta del backend Fastify (default: 3000)
PORT=3000

# Origine consentita per CORS — URL del frontend Angular in sviluppo
# In produzione cambia con l'URL effettivo del frontend
CORS_ORIGIN=http://localhost:4200
