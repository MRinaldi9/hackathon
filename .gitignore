# ============================================================
# .gitignore — Hagenthon / Inclusione Finanziaria
# CRITICO: .env non deve mai finire nel repository.
# ============================================================

# -- Variabili d'ambiente (SEGRETI — mai nel repo) ----------
.env
.env.local
.env.*.local

# -- Node / npm ---------------------------------------------
node_modules/
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -- Build Angular ------------------------------------------
dist/
out-tsc/
.angular/
*.tsbuildinfo

# -- Angular CLI --------------------------------------------
.angular-cli.json
.ng/

# -- Coverage e test ----------------------------------------
coverage/
e2e/test-output/

# -- Temporanei ---------------------------------------------
tmp/
*.tmp

# -- Stato sessioni (i file JSON di sessione in state/ sono
#    temporanei e non devono entrare nel repo se contengono
#    dati utente; .gitkeep è invece tracciato) ---------------
state/*.json

# -- OS e IDE -----------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
